{
  "name": "sl-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Data foundation for the Super League Discord bot rebuild",
  "type": "module",
  "engines": {
    "node": ">=22.5 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "legacy:inspect": "tsx scripts/inspect-legacy-database.ts",
    "commands:deploy:guild": "tsx scripts/deploy-commands.ts",
    "offers:expire": "tsx scripts/expire-offers.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.11",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "prisma": "6.19.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  }
}
