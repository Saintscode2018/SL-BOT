generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  id                    String                 @id @default(uuid())
  discordGuildId        String                 @unique
  name                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  settings              GuildSettings?
  clubs                 Club[]
  memberships           ClubMembership[]
  offers                Offer[]
  transactions          LeagueTransaction[]
  auditEvents           AuditEvent[]
  botPermissions        BotPermission[]
  moderationRoles       ModerationRole[]
  moderationCases       ModerationCase[]
  moderationCaseCounter ModerationCaseCounter?
}

model GuildSettings {
  id                     String   @id @default(uuid())
  guildId                String   @unique
  botCommandsChannelId   String?
  staffChannelId         String?
  transferChannelId      String?
  auditChannelId         String?
  caseFilesChannelId     String?
  botPermissionsRoleId   String?
  teamManagerRoleId      String?
  assistantManagerRoleId String?
  playerManagerRoleId    String?
  defaultSquadLimit      Int      @default(17)
  offerTimeoutSeconds    Int      @default(86400)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  guild                  Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Club {
  id                      String              @id @default(uuid())
  guildId                 String
  discordRoleId           String
  logoUrl                 String?
  emoji                   String
  squadLimitOverride      Int?
  active                  Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  guild                   Guild               @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships             ClubMembership[]
  offers                  Offer[]
  sourceTransactions      LeagueTransaction[] @relation("sourceClub")
  destinationTransactions LeagueTransaction[] @relation("destinationClub")

  // Active teams exclusively reserve their Discord role. The matching partial
  // unique index is maintained in SQL because Prisma's SQLite schema language
  // cannot express a partial unique index.
  @@index([guildId, discordRoleId])
  @@unique([id, guildId])
  @@index([guildId, active])
}

model LeagueUser {
  id                      String              @id @default(uuid())
  discordUserId           String              @unique
  robloxUserId            String?
  robloxUsername          String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  memberships             ClubMembership[]    @relation("member")
  membershipsCreated      ClubMembership[]    @relation("membershipCreator")
  membershipsEnded        ClubMembership[]    @relation("membershipEnder")
  offersReceived          Offer[]             @relation("offeredPlayer")
  offersCreated           Offer[]             @relation("offerCreator")
  transactions            LeagueTransaction[] @relation("transactionSubject")
  transactionsPerformed   LeagueTransaction[] @relation("transactionPerformer")
  transactionsReversed    LeagueTransaction[] @relation("transactionReverser")
  auditEvents             AuditEvent[]        @relation("auditActor")
  botPermissions          BotPermission[]     @relation("botPermissionHolder")
  botPermissionsGranted   BotPermission[]     @relation("botPermissionGranter")
  moderationRolesCreated  ModerationRole[]    @relation("moderationRoleCreator")
  moderationCasesTargeted ModerationCase[]    @relation("moderationCaseTarget")
  moderationCasesIssued   ModerationCase[]    @relation("moderationCaseIssuer")
  moderationCasesResolved ModerationCase[]    @relation("moderationCaseResolver")
}

model BotPermission {
  id              String      @id @default(uuid())
  guildId         String
  userId          String
  level           String
  grantedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  guild           Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            LeagueUser  @relation("botPermissionHolder", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy       LeagueUser? @relation("botPermissionGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, level])
}

model ModerationRole {
  id              String     @id @default(uuid())
  guildId         String
  discordRoleId   String
  createdByUserId String
  createdAt       DateTime   @default(now())
  guild           Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy       LeagueUser @relation("moderationRoleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([guildId, discordRoleId])
  @@index([guildId, createdAt])
}

model ModerationCaseCounter {
  guildId        String @id
  nextCaseNumber Int    @default(1)
  guild          Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ModerationCase {
  id               String      @id @default(uuid())
  guildId          String
  caseNumber       Int
  targetUserId     String
  issuedByUserId   String
  type             String
  reason           String?
  bail             Int
  durationSeconds  Int?
  expiresAt        DateTime?
  issuedAt         DateTime    @default(now())
  status           String      @default("ACTIVE")
  resolutionType   String?
  resolvedByUserId String?
  resolutionReason String?
  resolvedAt       DateTime?
  guild            Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  target           LeagueUser  @relation("moderationCaseTarget", fields: [targetUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  issuedBy         LeagueUser  @relation("moderationCaseIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy       LeagueUser? @relation("moderationCaseResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId, targetUserId, caseNumber])
  @@index([guildId, targetUserId, type, status])
}

model ClubMembership {
  id              String      @id @default(uuid())
  guildId         String
  clubId          String
  userId          String
  membershipType  String
  status          String      @default("ACTIVE")
  joinedAt        DateTime    @default(now())
  leftAt          DateTime?
  createdByUserId String?
  endedByUserId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  guild           Guild       @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  club            Club        @relation(fields: [clubId, guildId], references: [id, guildId], onDelete: Restrict, onUpdate: Cascade)
  user            LeagueUser  @relation("member", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       LeagueUser? @relation("membershipCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  endedBy         LeagueUser? @relation("membershipEnder", fields: [endedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([guildId, userId, status])
  @@index([clubId, membershipType, status])
}

model Offer {
  id                 String              @id @default(uuid())
  guildId            String
  clubId             String
  playerUserId       String
  offeredByUserId    String
  status             String              @default("PENDING")
  discordChannelId   String?
  discordMessageId   String?
  expiresAt          DateTime
  createdAt          DateTime            @default(now())
  respondedAt        DateTime?
  cancelledAt        DateTime?
  updatedAt          DateTime            @updatedAt
  guild              Guild               @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  club               Club                @relation(fields: [clubId, guildId], references: [id, guildId], onDelete: Restrict, onUpdate: Cascade)
  player             LeagueUser          @relation("offeredPlayer", fields: [playerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  offeredBy          LeagueUser          @relation("offerCreator", fields: [offeredByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leagueTransactions LeagueTransaction[]

  @@unique([id, guildId])
  @@index([guildId, playerUserId, status])
  @@index([clubId, status])
  @@index([status, expiresAt])
}

model LeagueTransaction {
  id                String      @id @default(uuid())
  guildId           String
  userId            String
  transactionType   String
  sourceClubId      String?
  destinationClubId String?
  performedByUserId String
  offerId           String?
  reason            String?
  createdAt         DateTime    @default(now())
  reversedAt        DateTime?
  reversedByUserId  String?
  guild             Guild       @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user              LeagueUser  @relation("transactionSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceClub        Club?       @relation("sourceClub", fields: [sourceClubId, guildId], references: [id, guildId], onDelete: Restrict, onUpdate: Cascade)
  destinationClub   Club?       @relation("destinationClub", fields: [destinationClubId, guildId], references: [id, guildId], onDelete: Restrict, onUpdate: Cascade)
  performedBy       LeagueUser  @relation("transactionPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  offer             Offer?      @relation(fields: [offerId, guildId], references: [id, guildId], onDelete: Restrict, onUpdate: Cascade)
  reversedBy        LeagueUser? @relation("transactionReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([guildId, createdAt])
  @@index([userId, createdAt])
  @@index([sourceClubId, createdAt])
  @@index([destinationClubId, createdAt])
}

model AuditEvent {
  id          String      @id @default(uuid())
  guildId     String
  actorUserId String?
  eventType   String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  metadata    Json?
  createdAt   DateTime    @default(now())
  guild       Guild       @relation(fields: [guildId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       LeagueUser? @relation("auditActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([guildId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
